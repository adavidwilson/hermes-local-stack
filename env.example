# Copy this file to .env and fill in real values. Do NOT commit .env.
# .env is the single source of secrets for the stack; scripts/render-quadlet-env.sh
# renders the per-service Quadlet environment files from it.
#
# This is not intended to be a publicly available instance.
# Secrets will live in plaintext on disk and in the runtime environment.

# Dashboard basic auth credentials. Required to accept requests to MagicDNS.
# Generate a strong password, e.g.:  openssl rand -hex 16.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_VALUE

TAILSCALE_AUTHKEY=GET_ME_FROM_TS_CONSOLE

# OpenRouter API key. The only model provider the stack uses: the agent, its
# side tasks (titling, compression, approval, vision), and delegated children all
# run on the model named in config.yaml (`deepseek/deepseek-v4.1-flash-1017`).
# Get one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=CHANGE_ME_OPENROUTER_KEY

# Optional: host UID/GID that own runtime/ files (default 1000).
# The Quadlet installer derives these from `id -u`/`id -g` and ignores values
# that differ; `keep-id` requires the host UID to match the container UID.
HERMES_UID=1000
HERMES_GID=1000

# Optional: extra project dir mounted at workspace/projects/Organize.
# HERMES_EXTRA_WORKSPACE=../Organize
